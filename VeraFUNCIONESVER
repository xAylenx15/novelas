

-- 		CREAMOS TABLAS 

-- CREAMOS LA TABLA DE NOVELAS
create table novelas(
	id_novela serial primary key,
	titulo varchar(255) not null,
	sinopsis text,
	portada varchar(255) not null,
	genero int references genero(id_genero),
	estado int references estado(id_estado)
);

-- CREAMOS LA TABLA CAPITULOS 
create table capitulos(
	id_capitulo serial primary key,
	id_novela int references novelas(id_novela),
	nombre varchar(255),
	numero int not null,
	texto text not null
);

-- MODIFICACION DE LA TABLA CAPITULOS
ALTER TABLE capitulos
ADD CONSTRAINT uq_capitulos_novela_numero
UNIQUE (id_novela, numero);
-- No permitira internamente que una novela tenga
-- como numero de capitulo el mismo que otro

-- CREAMOS LA TABLA GENERO 
create table genero(
	id_genero serial primary key,
	nombre varchar(50) not null unique
);

-- CREAMOS LA TABLA ESTADO 
create table estado(
	id_estado serial primary key,
	nombre varchar(50) not null unique
);

